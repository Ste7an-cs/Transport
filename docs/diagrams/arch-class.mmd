classDiagram
    direction TB

    class ITransport {
        <<interface>>
        +Start() Coro::Result~void~
        +Close() Coro::Result~void~  只发信号
        +WaitClosed() void  join
        +AsyncRead() 交出 read_queue 句柄
        +AsyncWrite(Datagram) Coro::Result~void~
        +LastError() error_code
        +CurrentLinkState() LinkState
    }
    class ICodec {
        <<interface>>
        +Encode(Message) bytes
        +Decode(bytes) Message[]
    }

    class ProtocolNode {
        +Request(Message, milliseconds) Coro::Result~Message~
        +Send(Message) Coro::Result~void~
        +Subscribe(Key) Ticket
        -DecodeAndDispatch() / Dispatch()
        -NextSession() uint8
    }
    class DdsNode {
        +Request(Message, target, options)
        +Publish(Message, topic)
        -Dispatch(kReply) / NextCorrelationId()
    }
    class NodeBase {
        <<生命周期基类>>
        +Start() / Close() / WaitClosed() / IsRunning()
        #DoStart()* / DoClose()* / DoJoin()*
    }
    class HandlerLoop~Event~ {
        <<协议无关机制>>
        +Spawn(consume) / Enqueue(e)
        +Join() / CancelAndClose()
    }
    class Dispatcher~T,Fields~ {
        <<协议无关机制>>
        +Subscribe(Key) Ticket
        +Dispatch(const T&) size_t
        +CloseAll(error)
        +Ticket::Wait(timeout) Coro::Result~T~
    }
    class HandlerContext {
        +Send()
        +RequestClose() 转调公开的 Close()
        +cancellation()
    }
    class ITraceSink {
        <<interface>>
        +OnTrace(TraceEvent)
    }

    class TcpTransport
    class TcpClientTransport {
        <<具体诊断，非多态缝>>
        +State() ConnectionState
        +WaitForState(target, options) Status
        +Generation() / AttemptCount() / LastFailure()
        +ApplyConfig(TcpClientConfig, version)
    }
    class UdpTransport
    class SerialTransport
    class DdsTransport
    class TcpServer
    class SystemCodec
    class DatagramCodec
    class DdsCodec

    ITransport <|.. TcpTransport
    ITransport <|.. TcpClientTransport
    ITransport <|.. UdpTransport
    ITransport <|.. SerialTransport
    ITransport <|.. DdsTransport
    ICodec <|.. SystemCodec
    ICodec <|.. DatagramCodec
    ICodec <|.. DdsCodec

    ProtocolNode ..> ITransport : 借用（宿主启停）
    ProtocolNode *-- ICodec : 组合
    ProtocolNode *-- Dispatcher : 组合
    ProtocolNode *-- HandlerLoop : 组合
    NodeBase <|-- ProtocolNode : 继承
    DdsNode *-- ITransport : 组合
    DdsNode *-- ICodec : 组合
    NodeBase <|-- DdsNode : 继承
    ProtocolNode ..> HandlerContext : 构造传入
    TcpServer ..> ProtocolNode : 每连接派生
    ProtocolNode ..> ITraceSink : 可选出口
