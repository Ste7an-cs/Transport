classDiagram
    direction TB

    class ITransport {
        <<interface>>
        +Start() Status
        +Read(options) Result~Datagram~
        +Write(SendUnit) Status
        +RequestClose() Status
        +WaitClosed(options) Status
        +LastSendTime() time_point
        +LastReceiveTime() time_point
        +LastError() error_code
        +CurrentLinkState() LinkState
    }
    class ICodec {
        <<interface>>
        +Encode(Message) bytes
        +Decode(bytes) Message[]
    }

    class ProtocolNode {
        +Start() / Close() / WaitClosed()
        +Request(Message, options) Result~Message~
        +Send(Message) Status
        -DecodeAndDispatch() / Dispatch()
        -AllocateSession() / SessionLease
    }
    class DdsNode {
        +Request(Message, target, options)
        +Publish(Message, topic)
        -Dispatch(kReply) / NextCorrelationId()
    }
    class NodeBase {
        <<生命周期基类>>
        +Start() / Close() / WaitClosed()
        #DoStart()* / DoClose()*
        -ConvergeAfterReadLoop() / ConvergeToClosed()
    }
    class HandlerLoop~Event~ {
        <<协议无关机制>>
        +Spawn(consume) / Enqueue(e)
        +Join() / CancelAndClose()
    }
    class PendingTable~K,T~ {
        <<协议无关机制>>
        +Register(key) Result~Handle~
        +Resolve(key, value) bool
        +FailAll(error, latch)
        +Handle::Wait(options) Result~T~
    }
    class BoundedQueue~T~ {
        <<协议无关机制>>
        +Push() / Pop() / Close() / Drain()
        +双上界 tail-drop
    }
    class HandlerContext {
        +Send()
        +RequestClose() 只发信号不等待
        +cancellation()
    }
    class SharedCompletion~T~ {
        +Complete(result) bool
        +Wait(options) Result~T~
    }
    class ITraceSink {
        <<interface>>
        +OnTrace(TraceEvent)
    }

    class TcpTransport
    class TcpClientTransport {
        <<具体诊断，非多态缝>>
        +State() ConnectionState
        +WaitForState(target, options) Status
        +Generation() / AttemptCount() / LastFailure()
        +ApplyConfig(TcpClientConfig, version)
    }
    class UdpTransport
    class SerialTransport
    class DdsTransport
    class TcpServer
    class SystemCodec
    class DatagramCodec
    class DdsCodec

    ITransport <|.. TcpTransport
    ITransport <|.. TcpClientTransport
    ITransport <|.. UdpTransport
    ITransport <|.. SerialTransport
    ITransport <|.. DdsTransport
    ICodec <|.. SystemCodec
    ICodec <|.. DatagramCodec
    ICodec <|.. DdsCodec

    ProtocolNode *-- ITransport : 组合
    ProtocolNode *-- ICodec : 组合
    ProtocolNode *-- PendingTable : 组合
    NodeBase <|-- ProtocolNode : 继承
    DdsNode *-- ITransport : 组合
    DdsNode *-- ICodec : 组合
    DdsNode *-- PendingTable : 组合
    NodeBase <|-- DdsNode : 继承
    HandlerLoop *-- BoundedQueue : 拥有
    PendingTable ..> SharedCompletion : 复用
    ProtocolNode ..> HandlerContext : 构造传入
    TcpServer ..> ProtocolNode : 每连接派生
    NodeBase ..> ITraceSink : 可选出口
