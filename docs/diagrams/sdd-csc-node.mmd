classDiagram
    direction TB
    class ProtocolNode {
        +Request(Message, options) Result~Message~
        +Send(Message) Status
        -DecodeAndDispatch() / Dispatch()
        -AllocateSession() / SessionLease
        -RunReactorLoop()
    }
    class DdsNode {
        +Request(Message, target, options)
        +Publish(Message, topic)
        -Dispatch(kReply) / NextCorrelationId()
    }
    class NodeBase {
        +Start() Status
        +Close() Status
        +WaitClosed(options) Status
        #DoStart()* Status
        #DoClose()* Status
        -ConvergeAfterReadLoop() / ConvergeToClosed()
    }
    class HandlerLoop~Event~ {
        +Spawn(consume) / Enqueue(e)
        +Join() / CancelAndClose()
    }
    class PendingTable~K_T~ {
        +Register(key) Result~Handle~
        +Resolve(key, value) bool
        +FailAll(error, latch)
        +Handle::Wait(options)
    }
    class BoundedQueue~T~ {
        +Push / Pop / Close / Drain
        +双上界 tail-drop
    }
    class HandlerContext {
        +Send / RequestClose(只发信号) / cancellation
    }

    NodeBase <|-- ProtocolNode : 继承
    ProtocolNode *-- PendingTable : 组合
    NodeBase <|-- DdsNode : 继承
    DdsNode *-- PendingTable : 组合
    ProtocolNode *-- HandlerLoop : 组合
    DdsNode *-- HandlerLoop : 组合
    HandlerLoop *-- BoundedQueue : 拥有
    ProtocolNode ..> HandlerContext : 构造传入
    DdsNode ..> HandlerContext : 构造传入
    note for PendingTable "entry = 裸 Coro::Awaitable~T~ 信箱\n表锁 find+erase 作唯一仲裁点"
