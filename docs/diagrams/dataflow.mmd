flowchart TB
    subgraph OUT["出站（调用方 fiber）"]
        direction LR
        RQ["Send / RequestFor*<br/>NextSession + 盖章"]
        SUB["Dispatcher.Subscribe(键)<br/>（Send 不登记；RequestForResult 登记两个）"]
        ENC["ICodec.Encode<br/>Message → 线缆字节"]
        WR["ITransport.AsyncWrite<br/>入队即返 · fire-and-forget"]
        WT["Ticket.Wait(timeout)<br/>挂起等唯一响应"]
        RQ --> SUB --> ENC --> WR --> WT
    end

    WR -. 线缆 → 对端 → 回送响应 .-> RD

    subgraph IN["入站（读-分发循环 fiber）"]
        direction LR
        RD["await(rx_)<br/>本节点的读订阅（shared）"]
        SK["node 读循环<br/>得到终止错误即退出并调 Close()"]
        DEC["ICodec.Decode<br/>字节 → 0..N Message"]
        DSP{"Dispatcher.Dispatch<br/>按键投给全部匹配订阅者"}
        RD --> SK --> DEC --> DSP
    end

    DSP -->|命中 ≥1| RES["各订阅者信箱各得一份副本"]
    DSP -->|0 份| NH["静默丢弃 · 不作记录<br/>（终结帧与业务帧处置相同，ADR-0014 D1/D4）"]
    RES --> HD["宿主自有消费 fiber<br/>await 信箱 → 自行串行 · 自行隔离异常<br/>满则静默丢最旧（不可观测）"]
    RES -. 唤醒 .-> WT

    DEC -.->|坏帧| BF["静默丢弃 · 不作记录"]
    WR -.->|目的地非法 / 报文超长 / 写失败| LE["只落 LastError()，不回传"]

    classDef greenC fill:#e8f3ea,stroke:#4a8c5a,color:#234;
    classDef goldC fill:#fbf6ef,stroke:#b8860b,color:#234;
    classDef blueC fill:#eef5fb,stroke:#3d6a8c,color:#234;
    classDef dropC fill:#faf0ea,stroke:#b5651d,color:#7a3b12;
    class SUB,WT,RES,BQ greenC;
    class ENC,DEC goldC;
    class RQ,WR,RD,SK,DSP,HD blueC;
    class NH,BF,LE dropC;
