flowchart TB
    APP([宿主应用])
    MEDIA([通信介质对端])

    P1["P1 出站（调用方 fiber）<br/>盖章 + 登记订阅 + Encode + AsyncWrite"]
    P2["P2 入站读循环（节点自有 fiber）<br/>await(rx_) + Decode"]
    P3{"P3 按键分配（Dispatcher）<br/>投给全部键匹配的订阅者"}
    P4["P4 业务消费（宿主自有 fiber）<br/>await 信箱 → 自行串行、自行隔离异常"]
    P5["P5 生命周期<br/>Close 只发信号 · WaitClosed 才 join"]

    D1[("D1 订阅索引<br/>Dispatcher：mask → 值 → Entry")]
    D2[("D2 订阅信箱<br/>Coro::Awaitable 有界 FIFO<br/>满则静默丢最旧（无归因，#152）")]
    D3[("D3 session_id 计数器<br/>uint8 自增回绕，取用不会失败")]
    D4[("D4 传输读/写双队列<br/>UdpTransport 泵持有（ADR-0007）")]

    APP -->|"Send / RequestFor*"| P1
    P1 -->|Subscribe 键| D1
    P1 -->|NextSession| D3
    P1 -->|"Encode → AsyncWrite（fire-and-forget，入队即返）"| D4
    D4 -->|socket 写出| MEDIA

    MEDIA -->|到达报文| D4
    D4 -->|"await(rx_) → Datagram"| P2
    P2 -->|"Decode → Message[]"| P3
    P3 -->|查索引| D1
    P3 -->|"命中 ≥1：各得一份副本"| D2

    D2 -.->|"唤醒 Ticket.Wait"| P1
    P1 -->|"Coro::Result~Message~ / 错误码"| APP
    D2 -->|业务帧| P4
    P4 -->|交付| APP

    P3 -->|"0 份 · 终结帧"| UM["kUnmatchedOrLateResponse 丢弃"]
    P3 -->|"0 份 · 业务帧"| SD["静默丢弃 · 不归因<br/>（无订阅者是常态，ADR-0009 D5）"]
    P2 -.->|坏帧| BF["kBadFrame 丢弃"]
    D4 -.->|"目的地非法 / 报文超长 / 写失败"| LE["只落 LastError()，不回传"]

    APP -->|Start / Close / WaitClosed| P5
    P5 -->|CloseAll error| D1
    P2 -.->|"读订阅返终止错误 → 退出并调 Close()"| P5

    classDef ext fill:#eef2f7,stroke:#93a4b5,color:#233;
    classDef proc fill:#eef5fb,stroke:#3d6a8c,color:#233;
    classDef store fill:#eaf3ea,stroke:#4a8c5a,color:#233;
    classDef dropC fill:#faf0ea,stroke:#b5651d,color:#7a3b12;
    class APP,MEDIA ext;
    class P1,P2,P3,P4,P5 proc;
    class D1,D2,D3,D4 store;
    class UM,SD,BF,LE dropC;
